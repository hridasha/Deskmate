# Copy to backend/.env and fill in what you need. Everything has a safe default; only an AI key is required.
# Keep real keys in .env only (it is gitignored). Keys can also be added later from Settings in the app.

# ---------------- AI providers (free tiers) ----------------
# Gemini: comma-separated keys, rotated. Keys from DIFFERENT Google projects each have their own daily quota.
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_MODELS_SMART=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Fallbacks used when Gemini is out of quota. Keys may be comma-separated too. Use separate accounts to add real capacity.
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free
CEREBRAS_API_KEY=
CEREBRAS_MODELS=llama-3.3-70b,llama3.1-8b
# What the Settings > Health quota panel assumes per key and model per day, as JSON. Gemini's free tier is about 20.
# DAILY_LIMITS_JSON={"gemini": 20, "groq": 1000}
# Optional price table (USD per 1M tokens: [input, output]) for the cost columns. Free tiers cost nothing.
# PRICES_JSON={"gemini-3.8-flash": [0.3, 2.5]}

# ---------------- Search and embeddings ----------------
# local = sentence-transformers on this machine (free, private, no quota). gemini = hosted. none = keyword search only.
EMBEDDINGS=auto
EMBED_MODEL_LOCAL=BAAI/bge-small-en-v1.5
# Cross-encoder reranking of search results: auto (on with local embeddings) | on | off | a model name.
RERANKER=auto
# Try several chunking methods on each large document and keep the best (local, no quota).
AUTO_TUNE=true

# ---------------- Security ----------------
# dev = admin screens (API keys, database connections) are open. Anything else locks them until ADMIN_TOKEN is set.
CASTCALL_ENV=prod
# Required in production when AUTH_MODE=off. Enter it in Settings to unlock admin actions.
ADMIN_TOKEN=
# Sign-in and team workspaces. off = one anonymous identity per browser (fine for local use).
# With on, the first sign-up creates a workspace and becomes its admin; others join with invite codes.
AUTH_MODE=off
# OPEN_SIGNUP=false makes new workspaces invitation-only once one exists.
OPEN_SIGNUP=true
# Signing key for sign-in tokens (generated and stored in the data folder if empty) and encryption key for saved API keys.
AUTH_SECRET=
SECRETS_KEY=
# true lets agents and database connections reach private network addresses (localhost, 10.x, 192.168.x). Keep false when exposed.
ALLOW_PRIVATE_HOSTS=false
# Set true only behind a reverse proxy you control: then the client address is read from X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ---------------- Limits ----------------
DAILY_LIMIT=200
MINUTE_LIMIT=12
IP_MINUTE_LIMIT=60

# ---------------- Automations ----------------
# Background loop for scheduled tasks and document sync. off to disable.
SCHEDULER=on
# How often web-page documents are re-checked and the watched folder is mirrored (minutes; 0 = never).
SYNC_INTERVAL_MIN=30
# Mirror a folder (a path inside the container, e.g. mount it in docker-compose) into this user's/workspace's knowledge base.
KNOWLEDGE_WATCH_DIR=
KNOWLEDGE_WATCH_USER=anon
# Email delivery for schedules and triggers (optional).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---------------- Data ----------------
# Where the database, uploads and keys live (the compose file mounts ./backend/data).
# CASTCALL_DATA_DIR=/app/data
